      "linux-x86_64": { "path": "dist/type-demo-v{version}-linux-x86_64.tar.gz", "entrypoint": "bin/type-demo", "format": "tar.gz" },
      "linux-aarch64": { "path": "dist/type-demo-v{version}-linux-aarch64.tar.gz", "entrypoint": "bin/type-demo", "format": "tar.gz" },
      "windows-x86_64": { "path": "dist/type-demo-v{version}-windows-x86_64.zip", "entrypoint": "bin/type-demo.exe", "format": "zip" }
    }
